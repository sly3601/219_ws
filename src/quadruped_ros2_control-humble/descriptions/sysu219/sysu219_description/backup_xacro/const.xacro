<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<!-- Constants for robot dimensions -->
	<xacro:property name="PI" value="3.1415926535897931"/>
	<xacro:property name="stick_mass" value="0.00001"/>

	<!-- simplified collision value -->
	<xacro:property name="trunk_width" value="0.3200"/> <!-- fixed -->
	<xacro:property name="trunk_length" value="0.8575"/><!-- fixed -->
	<xacro:property name="trunk_height" value="0.2300"/><!-- fixed -->
	<xacro:property name="hip_radius" value="0.0645"/>	<!-- fixed -->
	<xacro:property name="hip_length" value="0.2075"/>	<!-- fixed -->
	<xacro:property name="thigh_shoulder_radius" value="0.041"/>
	<xacro:property name="thigh_shoulder_length" value="0.032"/>
	<xacro:property name="thigh_width" value="0.0245"/>
	<xacro:property name="thigh_height" value="0.034"/>
